#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer PartialValueBuffer { float values[]; } partial_values;
layout(set = 0, binding = 1, std430) readonly buffer PartialIndexBuffer { uint values[]; } partial_indices;
layout(set = 0, binding = 2, std430) writeonly buffer ProposalBuffer { int values[]; } proposals;

layout(push_constant) uniform FinalArgmaxParams {
    uint groups;
    uint position;
    uint pad0;
    uint pad1;
} params;

shared float reductions[256];
shared uint indices[256];

bool better(float candidate_value, uint candidate_index,
            float current_value, uint current_index) {
    return candidate_value > current_value ||
           (candidate_value == current_value && candidate_index < current_index);
}

void main() {
    const uint lane = gl_LocalInvocationID.x;
    float best_value = -1.0 / 0.0;
    uint best_index = 0xffffffffu;
    for (uint group = lane; group < params.groups; group += 256u) {
        const float value = partial_values.values[group];
        const uint index = partial_indices.values[group];
        if (better(value, index, best_value, best_index)) {
            best_value = value;
            best_index = index;
        }
    }
    reductions[lane] = best_value;
    indices[lane] = best_index;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (lane < stride &&
            better(reductions[lane + stride], indices[lane + stride],
                   reductions[lane], indices[lane])) {
            reductions[lane] = reductions[lane + stride];
            indices[lane] = indices[lane + stride];
        }
        barrier();
    }
    if (lane == 0u) proposals.values[params.position] = int(indices[0]);
}
